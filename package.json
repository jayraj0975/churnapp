{
  "name": "churn-predictor",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive telecom customer-churn predictor: a trained logistic regression running in the browser, with factor contributions, what-if simulation and retention plans.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayraj0975/churnapp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "train-model": "python3 scripts/train_model.py",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "express": "^5.2.1",
    "dotenv": "^18.0.3",
    "motion": "^13.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
